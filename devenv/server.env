# 业务服务端开发配置（viper 前缀 TS_，层级用 _ 连接）。仅本地开发用，勿用于线上。
TS_MODE=debug
# 监听全部网卡：CloudFront 回源（安全组 pitchshow-dev-origin 只放行 CloudFront）+ WuKongIM 容器回调
TS_ADDR=0.0.0.0:18090
TS_GRPCADDR=172.17.0.1:16979
TS_ROOTDIR=/home/ec2-user/tsdd/devenv/data/server
TS_ADMINPWD=admin123456
TS_SMSCODE=123456
TS_DB_MYSQLADDR='root:demo@tcp(127.0.0.1:13306)/tsdd?charset=utf8mb4&parseTime=true&loc=Local'
# Redis：ElastiCache Valkey（PitchShowDevCache 栈）；回滚改回 127.0.0.1:16379（原容器保留）
TS_DB_REDISADDR=pitchshow-dev-cache.fcmlbq.ng.0001.ape1.cache.amazonaws.com:6379
TS_WUKONGIM_APIURL=http://127.0.0.1:15001
TS_EXTERNAL_IP=127.0.0.1
TS_EXTERNAL_BASEURL=https://dexample3.cloudfront.net/api
TS_EXTERNAL_WEBLOGINURL=https://dexample3.cloudfront.net
# 文件存储：s3（AWS S3，IAM 实例角色凭证）；回滚改回 minio 即可
TS_FILESERVICE=s3
TS_MINIO_URL=http://127.0.0.1:19000
TS_MINIO_UPLOADURL=http://127.0.0.1:19000
TS_MINIO_DOWNLOADURL=http://localhost:3000/minio
TS_MINIO_ACCESSKEYID=minioadmin
TS_MINIO_SECRETACCESSKEY=minioadmin
TS_APPNAME="Private IM tool"
TS_S3_BUCKET=pitchshow-im-dev-files-000000000000
TS_S3_REGION=ap-east-1
TS_S3_PRESIGNEXPIRE=3600
# 默认头像：S3 上 avatar/default/0..359.png（不再依赖外部 dicebear）
TS_AVATAR_DEFAULTCOUNT=360
